function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
var APP={
  state:{lang:'ar',theme:'dark',notifications:true,offers:true,orderNotifs:true,biometric:false,fontSize:'medium',user:null},
  cart:[],orders:[],favorites:[],notifications:[],
  products:[],banners:[],cats:[],banks:[],
  coupons:[],shipping:{fee:0,freeAbove:0},appliedCoupon:null,
  pickupLocations:null,selectedPickup:null,currentPickupTab:'aden',currentDistrict:null,
  currentProd:null,currentQty:1,selectedBank:null,currentSc:'home',
  
  init:async function(){
    var self=this;
    try{var s=localStorage.getItem('chizen_state');if(s){var p=JSON.parse(s);for(var k in p)if(p[k]!==undefined&&p[k]!==null)self.state[k]=p[k];}}catch(e){}
    try{self.cart=JSON.parse(localStorage.getItem('chizen_cart')||'[]');}catch(e){}
    try{self.favorites=JSON.parse(localStorage.getItem('chizen_favorites')||'[]');}catch(e){}
    self.applyState();
    self.syncBg();
    self.setupHistory();
  },
  
  syncBg:function(){
    var self=this;
    if(!window.FB||!FB.ready){setTimeout(function(){self.syncBg();},200);return;}
    if(FB.currentUser){self.onUserReady(FB.currentUser);return;}
    FB.auth.onAuthStateChanged(function(u){
      if(u){self.onUserReady(u);}
      else{setTimeout(function(){if(!FB.currentUser)window.location.replace('index.html');},3000);}
    });
  },
  
  onUserReady:function(u){
    var self=this;
    self.state.user={name:u.displayName||'User',email:u.email||'',uid:u.uid};
    self.updateUserUI();
    if(window.FB){
      FB.getUserProfile().then(function(p){if(p&&p.loyaltyPoints)self.state.loyaltyPoints=p.loyaltyPoints;self.updateLoyalty();});
      FB.getProducts().then(function(d){if(d&&d.length){self.products=d;self.renderProducts();self.renderFlash();}});
      FB.getConfig('banners').then(function(b){if(b&&b.list){self.banners=b.list;self.renderBanners();}});
      FB.getConfig('categories').then(function(c){
  var dbCats = (c && c.list) ? c.list : [];
  // إزالة أي قسم مكرر من الداتابيس يطابق الأقسام الثابتة
  var fixedKeys = window.FIXED_CATS.map(function(x){ return x.key; });
  var fixedNames = window.FIXED_CATS.map(function(x){ return x.name; });
  var extraCats = dbCats.filter(function(x){
    return fixedKeys.indexOf(x.key) === -1 && fixedNames.indexOf(x.name) === -1;
  });
  
  // دمج الأقسام الثابتة (أولاً) + الجديدة
  self.cats = window.FIXED_CATS.concat(extraCats);
  self.renderCats();
  if(self.checkServices) self.checkServices();
  if(self.renderBrands) self.renderBrands();
});
      FB.getConfig('payments').then(function(p){if(p&&p.list){self.banks=p.list;self.renderBanks();}});
      FB.getConfig('coupons').then(function(c){if(c&&c.list)self.coupons=c.list;});
      FB.getConfig('shipping').then(function(s){if(s)self.shipping=s;});
      FB.getUserOrders().then(function(o){if(o){self.orders=o;self.renderOrders();self.renderTrack();}});
      FB.getNotifications().then(function(n){if(n){self.notifications=n;self.updateNotifB();}});
    }
    setTimeout(function(){var sp=document.getElementById('splash');if(sp){sp.style.opacity='0';setTimeout(function(){sp.remove();},500);}},500);
  },
  
  updateUserUI:function(){
    var u=this.state.user;if(!u)return;
    var n=document.getElementById('home-user');if(n)n.textContent=u.name;
    var pn=document.getElementById('prof-n');if(pn)pn.textContent=u.name;
    var pe=document.getElementById('prof-e');if(pe)pe.textContent=u.email;
    var pa=document.getElementById('prof-av');if(pa)pa.textContent=u.name.charAt(0);
  },
  
  updateLoyalty:function(){
    var p=this.state.loyaltyPoints||0;
    var el=document.getElementById('loyalty');if(el)el.textContent=p+' نقطة';
    var pp=document.getElementById('prof-pts');if(pp)pp.textContent=p+' نقطة';
  },
  
  applyState:function(){
    document.documentElement.lang=this.state.lang;
    document.documentElement.dir=this.state.lang==='ar'?'rtl':'ltr';
    if(this.state.theme==='light')document.documentElement.setAttribute('data-theme','light');
    else document.documentElement.removeAttribute('data-theme');
  },
  
  saveState:function(){try{localStorage.setItem('chizen_state',JSON.stringify(this.state));}catch(e){}},
  
  setupHistory:function(){
    try{history.replaceState({s:'home'},'','#home');}catch(e){}
    var self=this;
    window.addEventListener('popstate',function(){if(self.currentSc!=='home'){self.navigate('home',false);}});
  },
  
  goTab: function(id, el) {
    this.navigate(id, true);
    try {
      var btns = document.querySelectorAll('.bn-it');
      btns.forEach(function(b) {
        b.classList.remove('active');
        b.style.color = '#9ca3af';
      });
      if (el) {
        el.classList.add('active');
        el.style.color = '#D81B60';
      } else {
        btns.forEach(function(b) {
          var oc = b.getAttribute('onclick') || '';
          if (oc.indexOf("'" + id + "'") > -1) {
            b.classList.add('active');
            b.style.color = '#D81B60';
          }
        });
      }
    } catch(e) {}
  },
  navigate: function(id, push) {
    if (push === undefined) push = true;
    if (this.currentSc === id) return;
    this.currentSc = id;
    
    // إخفاء كل الشاشات
    document.querySelectorAll('.screen').forEach(function(s) { s.classList.remove('active'); });
    var t = document.getElementById('sc-' + id);
    if (t) { t.classList.add('active'); t.scrollTop = 0; }
    
    // ═══ الشاشات التي تظهر فيها الشريط السفلي (الرئيسية فقط) ═══
    var mainTabs = ['home', 'orders', 'cart', 'profile'];
    var isMainTab = mainTabs.indexOf(id) !== -1;
    
    var nav = document.getElementById('bottom-nav');
    if (nav) {
      if (isMainTab) {
        nav.style.display = 'flex';
      } else {
        nav.style.display = 'none';
      }
    }
    
    // تحديث حالة الزر النشط
    if (window.APP && window.APP.goTab) {
      var btns = document.querySelectorAll('.bn-it');
      btns.forEach(function(b) {
        b.classList.remove('active');
        b.style.color = '#9ca3af';
        var oc = b.getAttribute('onclick') || '';
        if (oc.indexOf("'" + id + "'") > -1) {
          b.classList.add('active');
          b.style.color = '#D81B60';
        }
      });
    }
    
    // تنفيذ وظائف الشاشة
    if (id === 'cart') this.renderCart();
    if (id === 'orders') this.renderOrders();
    if (id === 'favorites') this.renderFav();
    if (id === 'notifications') this.renderNotifs();
    if (id === 'points') this.renderPoints();
    if (id === 'help') this.renderHelp();
    if (id === 'settings') this.renderSettings();
  },
  closeModal:function(){document.getElementById('modal').classList.remove('active');},
  closeDlg:function(){document.getElementById('dlg').classList.remove('active');},
  
  renderCats:function(){
    var c = document.getElementById('cats'); 
    if(!c) return;
    
    c.innerHTML = this.cats.map(function(cat) {
      return '<div class="photo-cat-card" onclick="APP.openCatPage(\'' + esc(cat.key) + '\',\'' + esc(cat.name) + '\',\'\')">' +
             '  <div class="photo-cat-circle">' +
             '    <img src="' + cat.img + '" alt="' + cat.name + '" loading="lazy">' +
             '  </div>' +
             '  <div class="photo-cat-name">' + esc(cat.name) + '</div>' +
             '</div>';
    }).join('');
  },
  
  
  // ═══ الحجوزات الحقيقية (Firebase) ═══
  
  saveBooking: async function(type, data) {
    if (!window.FB || !FB.currentUser) {
      if (window.toast) toast('سجل دخول أولاً', 'err');
      return;
    }
    try {
      var booking = {
        type: type,
        userId: FB.currentUser.uid,
        userEmail: FB.currentUser.email || '',
        userName: (FB.currentUser.displayName || FB.currentUser.email || 'مستخدم'),
        data: data,
        status: 'pending',
        createdAt: firebase.firestore.FieldValue.serverTimestamp()
      };
      await FB.db.collection('bookings').add(booking);
      
      // إشعار تلقائي للحجز
      var bookingTitle = type === 'flight' ? '✈️ حجز طيران' : type === 'bus' ? '🚌 حجز باص' : type === 'hotel' ? '🏨 حجز فندق' : '🕋 حجز حج وعمرة';
      if (window.pushUserNotification) {
        await window.pushUserNotification(
          bookingTitle + ' - قيد المراجعة',
          'تم استلام حجزك بنجاح، سنتواصل معك قريباً للتأكيد.',
          'booking',
          { bookingId: 'pending', type: type }
        );
      }
      
      return true;
    } catch(e) {
      console.error('Booking save error:', e);
      if (window.toast) toast('حدث خطأ في الحفظ', 'err');
      return false;
    }
  },

  submitFlight: async function() {
    var airline = document.getElementById('fly-airline');
    var from = document.getElementById('fly-from');
    var to = document.getElementById('fly-to');
    var date = document.getElementById('fly-date');
    var pax = document.getElementById('fly-pax');
    var cls = document.getElementById('fly-class');
    var name = document.getElementById('fly-name');
    var passport = document.getElementById('fly-passport');
    var phone = document.getElementById('fly-phone');
    
    if (!from || !to || !date || !name || !phone || !from.value || !to.value || !date.value || !name.value || !phone.value) {
      if (window.toast) toast('املأ جميع الحقول المطلوبة', 'err');
      return;
    }
    
    var btn = event.target;
    btn.disabled = true;
    btn.textContent = '⏳ جاري الحجز...';
    
    var ok = await this.saveBooking('flight', {
      airline: airline ? airline.value : '',
      from: from.value,
      to: to.value,
      date: date.value,
      passengers: pax ? pax.value : '1',
      class: cls ? cls.value : 'economy',
      name: name.value,
      passport: passport ? passport.value : '',
      phone: phone.value
    });
    
    btn.disabled = false;
    btn.textContent = 'تأكيد حجز الطيران';
    
    if (ok && window.showSuccess) {
      showSuccess({
        title: 'تم تأكيد حجزك! 🎉',
        message: 'سنتواصل معك قريباً لتأكيد التفاصيل والدفع.',
        btn: 'العودة للرئيسية',
        onClose: function() { if (window.APP) APP.goTab('home'); }
      });
    }
  },

