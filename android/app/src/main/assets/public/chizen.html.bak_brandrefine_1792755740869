  renderProducts:function(list){
    var c=document.getElementById('prods');if(!c)return;
    
    // إظهار Skeleton أثناء التحميل (إذا لم تكن القائمة ممررة)
    if(!list && (!this.products || this.products.length === 0)) {
        c.innerHTML = Array(4).fill('<div class="skeleton-card"><div class="skeleton-img"></div><div class="skeleton-text"></div><div class="skeleton-price"></div></div>').join('');
        return;
    }
    
    if(!list)list=this.products;
    if(!list.length){
        c.innerHTML='<div class="empty-state"><div class="empty-icon">🛍️</div><div class="empty-title">لا توجد منتجات حالياً</div><div class="empty-sub">تفقدنا قريباً، نعمل على إضافة منتجات رائعة لك!</div></div>';
        return;
    }
    c.innerHTML=list.map(function(p){
      var fav=APP.favorites.indexOf(p.id)>-1;
      return '<div class="prod" onclick="APP.openProduct(\''+esc(p.id)+'\')"><div class="prod-b">'+esc(p.badge||'')+'</div><div class="prod-f'+(fav?' active':'')+'" onclick="event.stopPropagation();APP.togFav(\''+esc(p.id)+'\',this)"><svg viewBox="0 0 24 24"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg></div><div class="prod-i"><img src="'+esc(p.img||'')+'" loading="lazy"><div class="color-swatches" id="color-swatches-container" style="display:none;"></div></div><div class="prod-inf"><div class="prod-n">'+esc(p.name)+'</div><div class="pr"><span class="price">'+esc(p.price)+'</span><span class="price-c">ر.س</span>'+(p.old?'<span class="price-o">'+esc(p.old)+'</span>':'')+'</div></div></div>';
    }).join('');
  },
  
  renderFlash:function(){
    var c=document.getElementById('flash-c');if(!c)return;
    var items=this.products.filter(function(p){return p.old&&(p.old-p.price)/p.old>0.15;}).slice(0,6);
    c.innerHTML=items.map(function(p){return '<div class="prod" onclick="APP.openProduct(\''+esc(p.id)+'\')"><div class="prod-i"><img src="'+esc(p.img||'')+'"><div class="prod-b">⚡ '+esc(p.badge)+'</div></div><div class="prod-inf"><div class="prod-n">'+esc(p.name)+'</div><div class="pr"><span class="price">'+esc(p.price)+'</span><span class="price-o">'+esc(p.old)+'</span></div></div></div>';}).join('');
  },
  
  renderBanners:function(){
    var s=document.getElementById('slides');var d=document.getElementById('dots');
    if(!s)return;
    s.innerHTML=this.banners.map(function(b){
      var img=b.img?'<img class="sl-img" src="'+esc(b.img)+'">':'';
      return '<div class="slide" style="background:'+esc(b.bg)+'">'+img+'<div class="sl-c"><div class="sl-tag">'+esc(b.tag||'')+'</div><div class="sl-title">'+esc(b.title||'')+'</div><div class="sl-sub">'+esc(b.sub||'')+'</div><button class="sl-btn">'+esc(b.btn||'تسوق')+'</button></div></div>';
    }).join('');
    d.innerHTML=this.banners.map(function(_,i){return '<div class="dot'+(i===0?' active':'')+'" onclick="APP.goSlide('+i+')"></div>';}).join('');
  },
  
  goSlide:function(i){
    var s=document.getElementById('slides');if(!s)return;
    s.style.transform='translateX('+(this.state.lang==='ar'?i*100:-i*100)+'%)';
    document.querySelectorAll('.dot').forEach(function(d,j){if(j===i)d.classList.add('active');else d.classList.remove('active');});
  },
  

  openCatPage: function(key, name, icon) {
    document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
    var catScreen = document.getElementById('sc-cat');
    if(!catScreen) return;
    catScreen.classList.add('active');
    catScreen.scrollTop = 0;
    this.currentSc = 'cat';

    document.getElementById('cat-title').innerHTML = icon + ' ' + name;

    var prods = this.products.filter(p => p.category === key);
    var grid = document.getElementById('cat-prods');
    
