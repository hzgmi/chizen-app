<script>
APP.renderColorSwatches = function(p) {
    const container = document.getElementById('color-swatches-container');
    if (!container) return;

    // بندور على الصورة الرئيسية في الشاشة
    const mainImg = document.querySelector('#sc-details img'); 
    
    if (!p.colors || p.colors.length === 0) {
        container.style.display = 'none';
        return;
    }

    container.style.display = 'flex';
    
    // إضافة الصورة الأساسية كأول لون (لو مش موجودة في المصفوفة)
    let allColors = [...p.colors];
    if (p.img || p.image) {
        if (!allColors.includes(p.img || p.image)) {
            allColors.unshift(p.img || p.image);
        }
    }

    container.innerHTML = allColors.map((imgUrl, index) => {
        return `<img src="${imgUrl}" class="color-swatch ${index === 0 ? 'active' : ''}" 
                onclick="APP.changeColor(this, '${imgUrl}')" 
                onerror="this.src='https://via.placeholder.com/60'">`;
    }).join('');
};

APP.changeColor = function(el, imgUrl) {
    // إزالة التحديد من كل الألوان
    document.querySelectorAll('.color-swatch').forEach(s => s.classList.remove('active'));
    // تحديد اللون اللي تم النقر عليه
    el.classList.add('active');
    
    // تغيير الصورة الرئيسية
    const mainImg = document.querySelector('#sc-details img');
    if (mainImg) {
        mainImg.src = imgUrl;
    }
};

// --- المفضلة ---
APP.getFavorites = function() {
    return JSON.parse(localStorage.getItem('chizen_favorites') || '[]');
};
APP.toggleFavorite = function(id, event) {
    if(event) event.stopPropagation(); // عشان ميفتحش المنتج
    let favs = this.getFavorites();
    let index = favs.indexOf(id);
    if (index > -1) {
        favs.splice(index, 1);
    } else {
        favs.push(id);
    }
    localStorage.setItem('chizen_favorites', JSON.stringify(favs));
    this.renderFavorites(); 
    
    // تحديث شكل القلوب في الشاشة
    document.querySelectorAll('.fav-btn[data-id="'+id+'"]').forEach(btn => {
        btn.style.color = favs.includes(id) ? '#D81B60' : '#888';
        btn.style.fill = favs.includes(id) ? '#D81B60' : 'none';
    });
};
APP.renderFavorites = function() {
    const grid = document.getElementById('wishlist-grid');
    if(!grid) return;
    const favs = this.getFavorites();
    const prods = window.APP.products || [];
    const favProds = prods.filter(p => favs.includes(p.id));
    
    if(favProds.length === 0) {
        grid.innerHTML = '<div style="text-align:center;color:#888;grid-column:1/-1;padding:50px;">لا توجد منتجات في المفضلة</div>';
        return;
    }
    grid.innerHTML = favProds.map(p => `
        <div class="p-card" onclick="APP.openProduct('${p.id}')">
            <svg class="fav-btn" data-id="${p.id}" onclick="APP.toggleFavorite('${p.id}', event)" viewBox="0 0 24 24" style="position:absolute;top:10px;left:10px;width:24px;height:24px;stroke:#D81B60;stroke-width:2;fill:#D81B60;z-index:10;"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            <img src="${p.img||p.image||''}" onerror="this.src='https://via.placeholder.com/150'">
            <div class="p-name">${p.name}</div>
            <div class="p-price">${p.price} ر.س</div>
        </div>
    `).join('');
};

// --- المنتجات المشابهة (هتتنادى جوه صفحة المنتج) ---
APP.renderRelatedProducts = function(currentProduct) {
    const relatedContainer = document.getElementById('related-products');
    if(!relatedContainer || !window.APP.products) return;
    
    // فلترة المنتجات اللي من نفس القسم ومش نفس المنتج الحالي
    let related = window.APP.products.filter(p => p.category === currentProduct.category && p.id !== currentProduct.id);
    
    // لو مفيش في نفس القسم، هات أي منتجات تانية
    if(related.length === 0) {
        related = window.APP.products.filter(p => p.id !== currentProduct.id).slice(0, 4);
    } else {
        related = related.slice(0, 4); // هنعرض 4 بس
    }

    if(related.length === 0) {
        relatedContainer.innerHTML = '';
        return;
    }

    relatedContainer.innerHTML = `
        <div style="margin-top: 30px; padding: 0 15px 30px;">
            <h3 style="color:#fff; font-size:16px; margin-bottom:15px; font-weight:bold;">منتجات مشابهة</h3>
            <div style="display: flex; gap: 10px; overflow-x: auto; padding-bottom: 10px;">
                ${related.map(p => `
                    <div onclick="APP.openProduct('${p.id}')" style="min-width: 120px; width: 120px; background: #f4f6fa; border-radius: 10px; overflow: hidden; padding-bottom: 8px;">
                        <img src="${p.img||p.image||''}" style="width: 100%; height: 100px; object-fit: cover;">
                        <div style="color: #fff; font-size: 11px; padding: 5px 8px 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${p.name}</div>
                        <div style="color: #D81B60; font-size: 12px; font-weight: bold; padding: 2px 8px;">${p.price} ر.س</div>
                    </div>
                `).join('')}
            </div>
        </div>
    `;
};

APP.getTimelineHtml = function(status) {
    const steps = [
        { key: 'pending', label: 'قيد المراجعة' },
        { key: 'shipped', label: 'تم الشحن' },
        { key: 'delivered', label: 'تم التوصيل' }
    ];
    
    let currentIndex = steps.findIndex(s => s.key === status);
    if (currentIndex === -1) currentIndex = 0; // افتراضي: قيد المراجعة
    if (status === 'cancelled') return '<div style="color:#ff4444;text-align:center;font-size:12px;margin-top:10px;">تم إلغاء الطلب</div>';

    let htmlStr = '<div class="order-timeline">';
    steps.forEach((step, idx) => {
        let activeClass = idx <= currentIndex ? 'active' : '';
        htmlStr += `
            <div class="order-timeline-step ${activeClass}">
                <div class="order-timeline-dot"></div>
                <div class="order-timeline-label">${step.label}</div>
            </div>
        `;
    });
    htmlStr += '</div>';
    return htmlStr;
};

