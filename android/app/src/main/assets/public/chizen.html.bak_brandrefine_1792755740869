<script>

// ================= الأقسام الأساسية المثبتة =================
window.FIXED_CATS = [
  { key: 'electronics', name: 'الإلكترونيات', img: 'https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?q=80&w=300&auto=format&fit=crop' }, 
  { key: 'fashion', name: 'الأزياء', img: 'https://images.unsplash.com/photo-1445205170230-053b83016050?q=80&w=300&auto=format&fit=crop' }, 
  { key: 'home', name: 'المنزل', img: 'https://images.unsplash.com/photo-1513694203232-719a280e022f?q=80&w=300&auto=format&fit=crop' }, 
  { key: 'beauty', name: 'الجمال', img: 'https://images.unsplash.com/photo-1596462502278-27bfdc403348?q=80&w=300&auto=format&fit=crop' }, 
  { key: 'kids', name: 'الأطفال', img: 'https://images.unsplash.com/photo-1558060370-d644479cb6f7?q=80&w=300&auto=format&fit=crop' }, 
  { key: 'sports', name: 'الرياضة', img: 'https://images.unsplash.com/photo-1542291026-7eec264c27ff?q=80&w=300&auto=format&fit=crop' }, 
  { key: 'tools', name: 'الأدوات', img: 'https://images.unsplash.com/photo-1581235720704-06d3acfcb36f?q=80&w=300&auto=format&fit=crop' } 
];
