<script>
document.addEventListener('DOMContentLoaded', function() {
    const ptr = document.getElementById('custom-ptr');
    const header = document.querySelector('.hd');
    let startY = 0;
    let isPulling = false;

    if (!header) return;

    header.addEventListener('touchstart', function(e) {
        const screen = document.querySelector('.screen.active') || document.documentElement;
        const scrollTop = screen.scrollTop || window.scrollY;
        if (scrollTop <= 0) {
            startY = e.touches[0].pageY;
            isPulling = true;
        } else {
            isPulling = false;
        }
    }, { passive: true });

    header.addEventListener('touchmove', function(e) {
        if (!isPulling) return;
        let currentY = e.touches[0].pageY;
        let deltaY = currentY - startY;
        if (deltaY > 70) {
            ptr.style.top = '15px';
        } else if (deltaY < 20) {
            ptr.style.top = '-80px';
        }
    }, { passive: true });

    header.addEventListener('touchend', function(e) {
        if (!isPulling) return;
        isPulling = false;
        if (ptr.style.top === '15px') {
            ptr.style.top = '-80px';
            setTimeout(function() { location.reload(); }, 300);
        }
    });
});


