document.addEventListener('DOMContentLoaded', function() {
    // دالة بتضيف القلوب للمنتجات
    const injectHearts = () => {
        const favs = APP.getFavorites ? APP.getFavorites() : [];
        document.querySelectorAll('.p-card').forEach(card => {
            if (card.querySelector('.fav-btn')) return; // لو موجود متضيفهوش تاني
            
            // استخراج ID المنتج من الـ onclick
            const onclickStr = card.getAttribute('onclick') || '';
            const match = onclickStr.match(/openProduct\('([^']+)'\)/);
            if (!match) return;
            const id = match[1];
            
            const isFav = favs.includes(id);
            const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
            svg.setAttribute('class', 'fav-btn');
            svg.setAttribute('data-id', id);
            svg.setAttribute('viewBox', '0 0 24 24');
            svg.style.cssText = `position:absolute;top:10px;left:10px;width:22px;height:22px;stroke:#D81B60;stroke-width:2;z-index:10;${isFav ? 'fill:#D81B60;' : 'fill:rgba(0,0,0,0.5);'}`;
            svg.innerHTML = '<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>';
            svg.onclick = (e) => APP.toggleFavorite(id, e);
            
            if (getComputedStyle(card).position === 'static') {
                card.style.position = 'relative';
            }
            card.appendChild(svg);
        });
    };

    // بنشغلها أول ما الصفحة تحمل
    setTimeout(injectHearts, 1000);
    // وبنشغلها كل ما نغير تاب
    if(window.APP && window.APP.goTab) {
        const originalGoTab = window.APP.goTab;
        window.APP.goTab = function(tab) {
            originalGoTab.apply(this, arguments);
            if(tab === 'home' || tab === 'wishlist') setTimeout(injectHearts, 500);
        };
    }
});
