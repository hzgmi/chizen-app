{
  "appId": "com.cheezan.app",
  "appName": "CHIZEN",
  "webDir": "www",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1000,
      "launchAutoHide": true,
      "backgroundColor": "#1A0B2E",
