rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    function isEmployee() { return isAdmin() && get(/databases/$(db)/documents/admins/$(request.auth.uid)).data.role == 'employee'; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    match /admins/{uid} { allow read: if isAdmin(); allow write: if false; }
    match /products/{id}  { 
      allow read: if true; 
      allow write: if isAdmin() && (!isEmployee() || request.resource.data.category == get(/databases/$(db)/documents/admins/$(request.auth.uid)).data.employeeCategory);
    }
    match /banners/{id}   { allow read: if true; allow write: if isAdmin() && !isEmployee(); }
    match /config/{id}    { allow read: if true; allow write: if isAdmin() && !isEmployee(); }

    match /notifications/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
    
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || (isAdmin() && !isEmployee()));
      allow write: if isSignedIn() && (request.auth.uid == uid || (isAdmin() && !isEmployee()));
    }

    match /orders/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /chats/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
      match /messages/{msgId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) || isAdmin();
        allow update, delete: if isAdmin();
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
