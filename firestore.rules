rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    function isEmployee() {
      return isAdmin() && get(/databases/$(db)/documents/admins/$(request.auth.uid)).data.role == 'employee';
    }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function employeeCategory() {
      return get(/databases/$(db)/documents/admins/$(request.auth.uid)).data.employeeCategory;
    }

    match /admins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin() && (!isEmployee() || request.resource.data.category == employeeCategory());
    }

    match /banners/{id}   { allow read: if true; allow write: if isAdmin() && !isEmployee(); }
    match /brands/{id}    { allow read: if true; allow write: if isAdmin() && !isEmployee(); }
    match /cats/{id}      { allow read: if true; allow write: if isAdmin() && !isEmployee(); }
    match /categories/{id}{ allow read: if true; allow write: if isAdmin() && !isEmployee(); }
    match /pays/{id}      { allow read: if true; allow write: if isAdmin() && !isEmployee(); }
    match /delivery/{id}  { allow read: if true; allow write: if isAdmin() && !isEmployee(); }
    match /config/{id}    { allow read: if true; allow write: if isAdmin() && !isEmployee(); }
    match /sups/{id}      { allow read: if isAdmin(); allow write: if isAdmin() && !isEmployee(); }
    match /balances/{id}  { allow read: if isAdmin(); allow write: if isAdmin() && !isEmployee(); }

    match /notifications/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
    match /admin_notifications/{id} {
      allow read, write: if isAdmin();
    }

    match /push_queue/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || (isAdmin() && !isEmployee()));
      allow write: if isSignedIn() && (request.auth.uid == uid || (isAdmin() && !isEmployee()));
      match /{sub=**} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    match /orders/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && (!('status' in request.resource.data) || request.resource.data.status == 'pending');
      allow update, delete: if isAdmin();
    }

    match /bookings/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /chats/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
      match /messages/{msgId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) || isAdmin();
        allow update, delete: if isAdmin();
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
