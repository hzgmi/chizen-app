rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    match /admins/{uid} { allow read: if isAdmin(); allow write: if false; }
    match /products/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /banners/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /config/{id}    { allow read: if true; allow write: if isAdmin(); }

    match /notifications/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
    match /admin_notifications/{id} { allow read, write: if isAdmin(); }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /orders/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.status == 'pending'; // يمنع المستخدم من تخطي حالة الانتظار
      allow update, delete: if isAdmin();
    }

    match /chats/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
      match /messages/{msgId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) || isAdmin();
        allow update, delete: if isAdmin();
      }
      match /stats/{date} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isAdmin();
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
